<%- include('partials/header') %>

<main class="container my-4">
    <h2>User Dashboard</h2>

    <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role_name === 'admin')) { %>
        <section class="mt-4">
            <h3>Registered Users</h3>

            <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                <table class="table table-striped mt-3">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                            <tr>
                                <td><%= u.user_id %></td>
                                <td><%= u.first_name %> <%= u.last_name %></td>
                                <td><%= u.email %></td>
                                <td><span class="badge"><%= u.role || u.role_name %></span></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No registered users found.</p>
            <% } %>
        </section>
    <% } else { %>
        <p>Welcome to your dashboard, <%= user ? user.first_name : 'User' %>!</p>
    <% } %>

    <section class="volunteered-projects my-4">
    <h3>My Volunteer Projects</h3>

    <% if (typeof volunteeredProjects !== 'undefined' && volunteeredProjects && volunteeredProjects.length > 0) { %>
        <ul class="list-group">
            <% volunteeredProjects.forEach(proj => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <a href="/project/<%= proj.project_id %>"><strong><%= proj.project_name %></strong></a>
                    </div>
                    <form action="/project/<%= proj.project_id %>/unvolunteer" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You haven't volunteered for any projects yet.</p>
    <% } %>
</section>
</main>

<%- include('partials/footer') %>