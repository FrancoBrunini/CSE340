<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
<p>
    <% if (user && user.role_name === 'admin') { %>

    <a href="/edit-project/<%= project.project_id %>" class="btn btn-edit">Edit Project</a>
    <a href="/assign-categories/<%= project.project_id %>" class="btn btn-primary">Assign Categories</a>
    <% } %>

</p>
    <h2><%= project.title %></h2>
    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    
    <p>
        <strong>Partner Organization:</strong> 
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>
    <% if (typeof user !== 'undefined' && user) { %>
    <% if (isVolunteered) { %>
        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
            <button type="submit" class="btn btn-danger">Leave Project</button>
        </form>
    <% } else { %>
        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
            <button type="submit" class="btn btn-primary">Become a Volunteer</button>
        </form>
    <% } %>
<% } else { %>
    <p><a href="/login">Log in</a> to volunteer for this project.</p>
<% } %>
</main>

<%- include('partials/footer') %>