<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>

    <form action="/edit-project/<%= project.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= project.title %>"
                maxlength="200"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="1000"
                required
            ><%= project.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= project.location %>"
                maxlength="200"
                required
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <% 
              // Formateo de fecha para que el input type="date" la reconozca (YYYY-MM-DD)
              let formattedDate = '';
              if (project.date) {
                  const d = new Date(project.date);
                  formattedDate = d.toISOString().split('T')[0];
              }
            %>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= formattedDate %>"
                required
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select
                id="organizationId"
                name="organizationId"
                required
            >
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option 
                        value="<%= org.organization_id %>"
                        <%= (org.organization_id == project.organization_id) ? 'selected' : '' %>
                    >
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Update Project</button>
        <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
    </form>
</main>

<%- include('partials/footer') %>